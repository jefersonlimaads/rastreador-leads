// Modelo de dados do escopo: toda tabela carrega clienteId, inclusive eventos e enviosCapi.
// Exclusão é lógica (arquivadoEm). Lead e clique nunca são apagados.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

enum Papel {
  ADMIN
  GESTOR
  ATENDENTE
}

enum StatusClique {
  PENDENTE
  CASADO
  SEM_CONTATO
}

enum Origem {
  MANUAL
  WEBHOOK
  FORMULARIO // a própria pessoa preencheu nome e telefone na landing page
}

/*
 * Modelo de funil do cliente. Não é etapa livre de propósito: com etapas
 * inventadas por cliente, a Carteira não conseguiria comparar nada entre eles.
 * São recortes da mesma lista ordenada.
 *
 * SIMPLES  — atende e fecha, sem etapa no meio. Clínica, psicóloga, salão.
 * COMPLETO — passa por proposta e negociação. Filmmaker, obra, consultoria.
 */
/*
 * Ciclo de vida do cliente na jl.ads. É a mesma empresa do começo ao fim: o
 * prospect que vira cliente não é recadastrado, muda de etapa. Assim não
 * existem dois cadastros da mesma empresa, que é onde esse tipo de sistema
 * costuma apodrecer.
 */
enum CicloCliente {
  PROSPECCAO // a abordar
  ABORDADO
  RESPONDEU
  REUNIAO_MARCADA
  PROPOSTA_ENVIADA
  NEGOCIANDO
  ATIVO
  PAUSADO
  ENCERRADO
  PERDIDO // prospect que disse não; diferente de cliente que saiu
}

enum TipoInteracao {
  MENSAGEM
  LIGACAO
  REUNIAO
  EMAIL
  NOTA
}

enum StatusProposta {
  RASCUNHO
  ENVIADA
  NEGOCIANDO
  ACEITA
  RECUSADA
}

enum StatusTarefa {
  ABERTA
  FEITA
}

enum StatusFatura {
  ABERTA
  PAGA
  CANCELADA
}

enum TipoFunil {
  SIMPLES
  COMPLETO
}

/*
 * Etapas do funil. Escolhidas para servir a nichos diferentes — reforma,
 * advocacia, estética, serviço técnico — sem virar configuração por cliente,
 * que complicaria o painel e as métricas.
 */
enum StatusLead {
  NOVO
  EM_ATENDIMENTO
  /*
   * Serve para o negócio: tem o problema, o perfil e a condição de comprar.
   * Sem essa etapa não existe taxa de qualificação nem custo por lead
   * qualificado — e é ela que separa "a campanha traz pouca gente" de "traz
   * gente errada", que pedem ações opostas.
   */
  QUALIFICADO
  PROPOSTA_ENVIADA
  NEGOCIANDO
  FECHADO
  PERDIDO
}

enum Atribuicao {
  EXATA
  PROVAVEL
  DESCONHECIDA
}

enum TipoEvento {
  MENSAGEM
  MUDANCA_STATUS
  CONTATO
  FOLLOW_UP
  NOTA
  RETORNO
}

enum TipoEnvioCapi {
  LEAD
  PURCHASE
}

/*
 * Agência: o inquilino do SaaS. Tudo pertence a uma — clientes, usuários,
 * tarefas — e nenhuma consulta do painel atravessa essa fronteira. A jl.ads é a
 * primeira agência; os dados que existiam antes da camada nasceram nela.
 */
model Agencia {
  id       String   @id @default(cuid())
  nome     String
  slug     String   @unique
  ativa    Boolean  @default(true)
  criadoEm DateTime @default(now())

  /*
   * Token do usuário do sistema da BM da agência, cifrado. Um só para todos
   * os clientes: cada cliente compartilha a conta de anúncios com a BM da
   * agência, e este token enxerga todas.
   */
  metaToken String?

  /*
   * Chave para mandar prospects de fora (Cowork, planilha, outra automação).
   * Guardada só como hash SHA-256: nem quem ler o banco consegue usá-la. A
   * chave inteira aparece uma vez, na hora de gerar; depois, só o final.
   */
  chaveImportacao    String?   @unique
  chaveImportacaoFim String?
  chaveImportacaoEm  DateTime?

  clientes Cliente[]
  usuarios Usuario[]
  servicos ServicoProposta[]
  tarefas  Tarefa[]
  buscas   BuscaProspeccao[]
}

model Cliente {
  id              String  @id @default(cuid())
  // Sem valor padrão de propósito: registro sem agência não pode existir, e
  // um padrão jogaria em silêncio o dado de uma agência dentro de outra.
  agenciaId       String
  nome            String
  contaAnunciosId String? // legado: as contas agora ficam em ContaAnuncios
  fuso            String    @default("America/Sao_Paulo")
  ativo           Boolean   @default(true)
  funil           TipoFunil @default(COMPLETO)

  /*
   * Lado comercial: dados da jl.ads sobre esse cliente, não do cliente. Só o
   * administrador enxerga. Gestor e atendente seguem vendo leads e campanhas.
   */
  ciclo          CicloCliente @default(ATIVO)
  feeMensal      Decimal?     @db.Decimal(12, 2)
  diaVencimento  Int? // 1 a 28, para existir em todo mês
  inicioContrato DateTime?
  /*
   * Fim do contrato: a data em que a renovação precisa estar conversada. A
   * rotina diária abre a tarefa 30 dias antes, que é quando ainda dá tempo de
   * mostrar resultado em vez de pedir renovação no susto.
   */
  fimContrato    DateTime? @db.Date
  /*
   * Custo direto desse cliente por mês: freelancer, ferramenta, quem edita o
   * criativo. Sem isso, fee alto passa por cliente bom mesmo dando prejuízo.
   */
  custoMensal    Decimal?  @db.Decimal(12, 2)
  documento      String? // CNPJ ou CPF
  contatoNome    String?
  contatoEmail   String?
  contatoTelefone String?
  linkPagamento  String? // link fixo de cobrança, enquanto não houver provedor
  observacoes    String?

  /*
   * Meta do mês, combinada com o cliente. Sem isso, ninguém sabe no dia 20 se
   * o mês vai fechar acima ou abaixo do combinado.
   */
  orcamentoMensal Decimal? @db.Decimal(12, 2)
  metaContatos    Int?
  metaCpl         Decimal? @db.Decimal(12, 2)

  // Prospecção: de onde veio, o que faz, quando retomar e por que foi perdido.
  nicho          String?
  origem         String? // indicação, Instagram, abordagem fria, evento
  instagram      String?
  site           String?
  proximoContato DateTime? @db.Date
  motivoPerda    String?
  reuniaoEm      DateTime? // data e hora da reunião agendada

  // Credenciais do Meta por cliente. marketingToken é opcional: sem ele, vale
  // o token da agência (Agencia.metaToken).
  pixelId        String?
  capiToken      String?
  marketingToken String?

  // Link de confirmação que o cliente abre sem senha. Trocar o token derruba o
  // link antigo, que é o que se faz quando alguém sai da equipe dele.
  tokenConfirmacao String? @unique

  criadoEm DateTime @default(now())

  numeros    NumeroWhatsapp[]
  usuarios   Usuario[]
  acessos    AcessoCliente[]
  cliques    Clique[]
  leads      Lead[]
  eventos    Evento[]
  vendas     Venda[]
  gastos     Gasto[]
  enviosCapi EnvioCapi[]
  faturas    Fatura[]
  tarefas    Tarefa[]
  propostas  Proposta[]
  interacoes Interacao[]
  relatorios Relatorio[]
  entregas   Entrega[]
  contas     ContaAnuncios[]
  diagnostico Diagnostico?

  agencia Agencia @relation(fields: [agenciaId], references: [id])

  @@index([agenciaId, ciclo])
}

/*
 * Cada toque num prospect: mensagem, ligação, reunião. É o histórico que
 * responde "o que eu já falei com essa pessoa?" antes de retomar o contato.
 */
model Interacao {
  id        String        @id @default(cuid())
  clienteId String
  tipo      TipoInteracao
  descricao String
  criadoEm  DateTime      @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, criadoEm])
}

/*
 * Cobrança mensal de um cliente. Uma por mês de competência, gerada pela rotina
 * diária no primeiro dia do mês para quem está ativo e tem fee.
 */
/*
 * Tarefa da operação. clienteId nulo = tarefa da jl.ads, sem dono externo:
 * proposta a escrever, conteúdo a gravar, cobrança a fazer. Com clienteId, é
 * trabalho daquele cliente e aparece dentro do ambiente dele.
 */
model Tarefa {
  id        String       @id @default(cuid())
  agenciaId String
  clienteId String?
  titulo    String
  descricao String?
  prazo     DateTime?    @db.Date
  status    StatusTarefa @default(ABERTA)
  criadoEm  DateTime     @default(now())
  feitoEm   DateTime?

  // Com horário, a tarefa ocupa um bloco na agenda; sem, fica no dia inteiro.
  inicio     DateTime?
  duracaoMin Int?

  // Tarefa criada pela mudança de etapa. A chave diz de qual etapa ela veio,
  // para não duplicar e para concluir sozinha quando o prospect avança.
  automatica Boolean @default(false)
  chave      String?

  criadoPorId String?
  agencia     Agencia  @relation(fields: [agenciaId], references: [id])
  cliente     Cliente? @relation(fields: [clienteId], references: [id])
  criadoPor   Usuario? @relation(fields: [criadoPorId], references: [id])

  @@index([agenciaId, status, prazo])
  @@index([clienteId, status])
  @@index([agenciaId, status, inicio])
}

/*
 * Proposta comercial da jl.ads para um prospect. O prospect é um Cliente em
 * etapa inicial do ciclo: aceitar a proposta o torna ativo, com o fee dela.
 *
 * O lead abre pelo link, sem senha, e responde por ali mesmo. "Visualizada" é
 * derivada de visualizadaEm, não é status: aberta e aceita não se excluem.
 */
model Proposta {
  id        String         @id @default(cuid())
  clienteId String
  token     String         @unique
  status    StatusProposta @default(RASCUNHO)

  titulo      String
  apresentacao String? // parágrafo de abertura, escrito para esse lead
  escopo      Json // lista de { titulo, detalhe } do que está incluído
  /*
   * Dois valores: o de tabela e o que o cliente paga. Desconto que não aparece
   * não é desconto — é só um preço menor, e o cliente nunca fica sabendo que
   * ganhou alguma coisa.
   */
  feeCheio    Decimal? @db.Decimal(12, 2)
  feeMensal   Decimal? @db.Decimal(12, 2)
  setupCheio  Decimal? @db.Decimal(12, 2)
  setup       Decimal? @db.Decimal(12, 2) // valor único de implantação
  /* Período de contrato em meses. Null = sem prazo mínimo. */
  meses       Int?
  condicoes   String? // prazo mínimo, forma de pagamento, verba de mídia à parte
  validade    DateTime @db.Date

  enviadaEm     DateTime?
  visualizadaEm DateTime?
  visualizacoes Int       @default(0)
  respondidaEm  DateTime?
  aceitaPor     String? // nome digitado por quem aceitou
  motivoRecusa  String?

  // Acompanhamento depois do envio: quando retomar e o que já foi conversado.
  proximoContato DateTime? @db.Date
  notas          String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@index([clienteId, criadoEm])
  @@index([status])
}

/**
 * Catálogo de serviços da agência: o que pode ser oferecido numa proposta.
 * A proposta guarda uma cópia do que foi marcado, então mexer aqui depois não
 * reescreve proposta já enviada.
 */
model ServicoProposta {
  id        String  @id @default(cuid())
  agenciaId String
  nome      String
  detalhe   String?
  ordem     Int     @default(0)
  ativo     Boolean @default(true)

  criadoEm DateTime @default(now())
  agencia  Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  @@index([agenciaId, ordem])
}

model Fatura {
  id          String       @id @default(cuid())
  clienteId   String
  competencia DateTime     @db.Date // primeiro dia do mês cobrado
  valor       Decimal      @db.Decimal(12, 2)
  vencimento  DateTime     @db.Date
  status      StatusFatura @default(ABERTA)
  pagoEm      DateTime?
  linkPagamento String?
  observacao  String?
  criadoEm    DateTime     @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@unique([clienteId, competencia])
  @@index([clienteId, vencimento])
  @@index([status, vencimento])
}

model NumeroWhatsapp {
  id        String  @id @default(cuid())
  clienteId String
  numero    String // E.164 só com dígitos, ex: 5511999999999
  rotulo    String?
  ativo     Boolean @default(true)

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
}

model Usuario {
  id        String  @id @default(cuid())
  agenciaId String
  clienteId String? // nulo = equipe da agência, vê todos os clientes dela
  // Dono da plataforma: cria agências. Não tem nada a ver com o papel dentro
  // de uma agência, e não dá acesso aos dados de outras agências pelo painel.
  plataforma Boolean @default(false)
  nome      String
  email     String  @unique
  senhaHash String
  papel     Papel   @default(ATENDENTE)
  ativo     Boolean @default(true)

  criadoEm DateTime @default(now())

  agencia          Agencia  @relation(fields: [agenciaId], references: [id])
  cliente          Cliente? @relation(fields: [clienteId], references: [id])
  acessos          AcessoCliente[]
  leadsResponsavel Lead[]   @relation("responsavel")
  eventos          Evento[]
  tarefas          Tarefa[]

  @@index([clienteId])
}

/**
 * Quais clientes um colaborador da agência alcança.
 *
 * Sem nenhuma linha, ele alcança todos os da agência — é o colaborador sem
 * restrição, e mantém funcionando quem já estava cadastrado. Com linhas, só os
 * listados: é assim que o administrador entrega um cliente sem entregar a
 * carteira inteira.
 *
 * Não vale para usuário do cliente, que continua preso ao próprio por
 * Usuario.clienteId.
 */
model AcessoCliente {
  id        String   @id @default(cuid())
  usuarioId String
  clienteId String
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, clienteId])
  @@index([usuarioId])
}

model Clique {
  id        String @id @default(cuid())
  clienteId String
  codigo    String

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  campaignId String?
  adsetId    String?
  adId       String?

  fbclid    String?
  fbp       String?
  fbc       String?
  ip        String?
  userAgent String?
  url       String?

  /*
   * O que a pessoa escolheu na landing page: o serviço do botão que ela clicou,
   * a opção marcada num formulário, ou o texto do próprio botão. É por aqui que
   * quem atende reconhece de quem se trata, em vez de decorar telefone.
   */
  interesse String?

  /*
   * Nome e telefone que a própria pessoa preencheu na landing page, quando a
   * página tem formulário antes do botão de WhatsApp. É o que permite a quem
   * atende reconhecer dez pedidos do mesmo serviço no mesmo dia.
   */
  nomeVisitante     String?
  telefoneVisitante String?

  /*
   * Os outros campos do formulário, do jeito que a página perguntou: empresa,
   * evento, data, cidade, o que for. Lista de { rotulo, valor }.
   *
   * Guardado assim, sem coluna por campo, porque cada cliente pergunta uma
   * coisa diferente — e é justamente isso que faz quem atende reconhecer a
   * pessoa em vez de olhar para um telefone solto.
   */
  campos Json?

  status   StatusClique @default(PENDENTE)
  criadoEm DateTime     @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id])
  lead    Lead?

  @@unique([clienteId, codigo])
  @@index([clienteId, status, criadoEm])
  @@index([clienteId, adId])
}

model Lead {
  id             String  @id @default(cuid())
  clienteId      String
  cliqueId       String? @unique
  leadAnteriorId String? // oportunidade nova de um telefone que já foi lead

  // Opcional: a confirmação em lote pelo cliente não exige digitar telefone.
  // Sem ele o lead conta em CPL, CAC e ROAS, mas fica fora da fila de follow-up
  // com botão de abrir conversa.
  telefone String?
  nome     String?

  origem     Origem     @default(MANUAL)
  status     StatusLead @default(NOVO)
  atribuicao Atribuicao @default(DESCONHECIDA)

  mensagemEm DateTime // horário da mensagem, base da janela de atribuição
  valorVenda Decimal? @db.Decimal(12, 2)
  /*
   * Categoria padronizada da perda, da lista de MOTIVOS_PERDA. É o que torna o
   * motivo comparável entre clientes e entre campanhas; motivoPerda continua
   * guardando a observação em texto livre, que é onde mora o detalhe.
   */
  motivoPerdaCategoria String?
  motivoPerda String?

  responsavelId String?

  criadoEm    DateTime  @default(now())
  fechadoEm   DateTime?
  arquivadoEm DateTime?

  cliente       Cliente   @relation(fields: [clienteId], references: [id])
  clique        Clique?   @relation(fields: [cliqueId], references: [id])
  leadAnterior  Lead?     @relation("retorno", fields: [leadAnteriorId], references: [id])
  leadsSeguintes Lead[]   @relation("retorno")
  responsavel   Usuario?  @relation("responsavel", fields: [responsavelId], references: [id])

  eventos    Evento[]
  enviosCapi EnvioCapi[]
  vendas     Venda[]

  @@index([clienteId, telefone])
  @@index([clienteId, status, criadoEm])
  @@index([clienteId, criadoEm])
}

/**
 * Uma venda fechada com o lead. Existe porque o mesmo cliente compra mais de
 * uma vez: fecha um serviço, e semanas depois fecha outro. Todo esse
 * faturamento veio da mesma mídia, e antes não havia onde somar o segundo.
 *
 * Lead.valorVenda continua sendo o total, mantido em dia a cada venda. É o que
 * relatório, ROAS e custo por venda já leem — nenhum número muda de fonte.
 */
model Venda {
  id        String   @id @default(cuid())
  clienteId String
  leadId    String
  valor     Decimal  @db.Decimal(12, 2)
  descricao String? // "implantação", "segundo serviço": o que foi vendido
  fechadoEm DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([clienteId, fechadoEm])
  @@index([leadId])
}

model Evento {
  id        String     @id @default(cuid())
  clienteId String
  leadId    String
  tipo      TipoEvento
  descricao String?
  usuarioId String?
  criadoEm  DateTime   @default(now())

  cliente Cliente  @relation(fields: [clienteId], references: [id])
  lead    Lead     @relation(fields: [leadId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([leadId, criadoEm])
  @@index([clienteId, criadoEm])
}

model Gasto {
  id         String   @id @default(cuid())
  clienteId  String
  adId       String
  adsetId    String?
  campaignId String?

  adNome       String?
  adsetNome    String?
  campaignNome String?

  dia          DateTime @db.Date
  valor        Decimal  @db.Decimal(12, 2)
  impressoes   Int      @default(0)
  cliques      Int      @default(0)
  atualizadoEm DateTime @updatedAt

  /*
   * O que o Meta diz que o anúncio entregou naquele dia. objetivo é o da
   * campanha (OUTCOME_LEADS...), otimizacao é o do conjunto (CONVERSATIONS,
   * OFFSITE_CONVERSIONS...) e decide qual número é "o resultado". acoes e
   * valoresAcoes guardam a lista inteira do Meta ({ tipo: quantidade }), para
   * um tipo novo de campanha não exigir outra migration.
   */
  objetivo     String?
  otimizacao   String?
  cliquesLink  Int      @default(0)
  /*
   * Cliques de saída: quem de fato tentou sair do Meta. É a base mais honesta
   * para CTR e custo por clique — cliquesLink conta interação que às vezes nem
   * sai da plataforma. Zero quando a conta não reporta; aí vale cliquesLink.
   */
  cliquesSaida Int      @default(0)
  /*
   * Visualizações da página de destino, contadas pelo Meta. Vive também dentro
   * de acoes; aqui em coluna própria porque é somada e ordenada o tempo todo,
   * e extrair de JSON em agregação é caro.
   */
  visualizacoesPagina Int @default(0)
  /*
   * Alcance e frequência do dia. NÃO SOMAM entre dias: alcance é gente única, e
   * somar sete dias contaria a mesma pessoa sete vezes. Servem para leitura do
   * dia e para o período pedido de uma vez ao Meta.
   */
  alcanceDia  Int      @default(0)
  frequencia  Decimal? @db.Decimal(6, 2)
  /* Mesmo criativo roda em anúncios e campanhas diferentes: o id é o que
     permite comparar a peça, e não o anúncio que a embrulha. */
  creativeId   String?
  acoes        Json?
  valoresAcoes Json?

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@unique([clienteId, adId, dia])
  @@index([clienteId, creativeId])
  @@index([clienteId, dia])
}

model EnvioCapi {
  id        String        @id @default(cuid())
  clienteId String
  leadId    String
  eventId   String        @unique // event_id próprio, para deduplicação no Meta
  tipo      TipoEnvioCapi
  valor     Decimal?      @db.Decimal(12, 2)

  statusResposta Int?
  resposta       String?
  payload        Json
  tentativas     Int      @default(0)
  enviadoEm      DateTime?
  criadoEm       DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id])
  lead    Lead    @relation(fields: [leadId], references: [id])

  @@index([clienteId, criadoEm])
  @@index([leadId])
}

/*
 * Relatório de resultados enviado ao cliente. Guarda só o período e o
 * comentário: os números são recalculados a cada abertura, então gasto que o
 * Meta revisou depois aparece certo. Apagar o registro derruba o link.
 */
model Relatorio {
  id            String    @id @default(cuid())
  clienteId     String
  token         String    @unique
  de            DateTime  @db.Date
  ate           DateTime  @db.Date
  /*
   * Link vivo: em vez de um período fixo, mostra sempre os últimos N dias.
   * É o link que o cliente guarda e abre quando quiser.
   */
  diasMoveis    Int?
  comentario    String?
  criadoPor     String?
  criadoEm      DateTime  @default(now())
  visualizadoEm DateTime?
  visualizacoes Int       @default(0)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, criadoEm])
}

/*
 * Contas de anúncios do Meta de um cliente. Pode ser mais de uma (campanhas
 * de conversão numa, de alcance em outra). contaId no formato "act_123".
 * Substitui Cliente.contaAnunciosId, que fica só por compatibilidade.
 */
model ContaAnuncios {
  id        String   @id @default(cuid())
  clienteId String
  contaId   String
  nome      String?
  criadoEm  DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, contaId])
  @@index([contaId])
}

/*
 * Uma rodada de prospecção automática: nicho + cidade no Google, cada empresa
 * encontrada vira um Diagnostico, e as que passam da nota mínima viram
 * prospect em "A abordar". status: RODANDO, CONCLUIDA, ERRO (texto, não enum:
 * estado novo não exige migration antes do deploy).
 */
model BuscaProspeccao {
  id          String    @id @default(cuid())
  agenciaId   String
  nicho       String
  cidade      String
  quantidade  Int
  notaMinima  Int       @default(50)
  /// De onde vieram as empresas: google, osm (mapa aberto) ou lista (colada).
  fonte       String    @default("google")
  status      String    @default("RODANDO")
  encontrados Int       @default(0)
  analisados  Int       @default(0)
  adicionados Int       @default(0)
  erro        String?
  criadoEm    DateTime  @default(now())
  atualizadoEm DateTime @updatedAt
  concluidaEm DateTime?

  agencia      Agencia       @relation(fields: [agenciaId], references: [id])
  diagnosticos Diagnostico[]

  @@index([agenciaId, criadoEm])
}

/*
 * O que a pesquisa descobriu sobre uma empresa. Fica guardado mesmo quando ela
 * não passa da nota: assim a próxima busca não traz a mesma empresa de novo, e
 * dá para promover um descartado se você discordar da nota.
 * status: PENDENTE, ANALISADO, DESCARTADO, ERRO.
 */
model Diagnostico {
  id         String  @id @default(cuid())
  agenciaId  String
  buscaId    String?
  clienteId  String? @unique
  placeId    String
  nome       String
  categoria  String?
  telefone   String?
  site       String?
  endereco   String?
  mapsUrl    String?
  notaGoogle Float?
  avaliacoes Int?
  instagram  String?
  facebook   String?

  sinais    Json?
  pontuacao Int?
  resumo    String?
  gaps      Json?
  briefing  String?
  mensagem  String?
  analisadoPorIa Boolean @default(false)

  status      String    @default("PENDENTE")
  erro        String?
  criadoEm    DateTime  @default(now())
  analisadoEm DateTime?

  busca   BuscaProspeccao? @relation(fields: [buscaId], references: [id], onDelete: SetNull)
  cliente Cliente?         @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@unique([agenciaId, placeId])
  @@index([buscaId, status])
}

/*
 * O que a agência entregou no mês: criativos gravados, campanhas subidas,
 * ajustes feitos. Responde ao "o que vocês fizeram esse mês?" — a pergunta
 * que costuma vir junto com o pedido de desconto ou de cancelamento.
 */
model Entrega {
  id          String   @id @default(cuid())
  clienteId   String
  competencia DateTime @db.Date // primeiro dia do mês
  tipo        String // criativo, campanha, otimização, reunião, outro
  descricao   String
  criadoEm    DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, competencia])
}
