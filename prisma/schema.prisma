// Modelo de dados do escopo: toda tabela carrega clienteId, inclusive eventos e enviosCapi.
// Exclusão é lógica (arquivadoEm). Lead e clique nunca são apagados.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

enum Papel {
  ADMIN
  GESTOR
  ATENDENTE
}

enum StatusClique {
  PENDENTE
  CASADO
  SEM_CONTATO
}

enum Origem {
  MANUAL
  WEBHOOK
}

/*
 * Modelo de funil do cliente. Não é etapa livre de propósito: com etapas
 * inventadas por cliente, a Carteira não conseguiria comparar nada entre eles.
 * São recortes da mesma lista ordenada.
 *
 * SIMPLES  — atende e fecha, sem etapa no meio. Clínica, psicóloga, salão.
 * COMPLETO — passa por proposta e negociação. Filmmaker, obra, consultoria.
 */
/*
 * Ciclo de vida do cliente na jl.ads. É a mesma empresa do começo ao fim: o
 * prospect que vira cliente não é recadastrado, muda de etapa. Assim não
 * existem dois cadastros da mesma empresa, que é onde esse tipo de sistema
 * costuma apodrecer.
 */
enum CicloCliente {
  PROSPECCAO // a abordar
  ABORDADO
  RESPONDEU
  REUNIAO_MARCADA
  PROPOSTA_ENVIADA
  NEGOCIANDO
  ATIVO
  PAUSADO
  ENCERRADO
  PERDIDO // prospect que disse não; diferente de cliente que saiu
}

enum TipoInteracao {
  MENSAGEM
  LIGACAO
  REUNIAO
  EMAIL
  NOTA
}

enum StatusProposta {
  RASCUNHO
  ENVIADA
  NEGOCIANDO
  ACEITA
  RECUSADA
}

enum StatusTarefa {
  ABERTA
  FEITA
}

enum StatusFatura {
  ABERTA
  PAGA
  CANCELADA
}

enum TipoFunil {
  SIMPLES
  COMPLETO
}

/*
 * Etapas do funil. Escolhidas para servir a nichos diferentes — reforma,
 * advocacia, estética, serviço técnico — sem virar configuração por cliente,
 * que complicaria o painel e as métricas.
 */
enum StatusLead {
  NOVO
  EM_ATENDIMENTO
  PROPOSTA_ENVIADA
  NEGOCIANDO
  FECHADO
  PERDIDO
}

enum Atribuicao {
  EXATA
  PROVAVEL
  DESCONHECIDA
}

enum TipoEvento {
  MENSAGEM
  MUDANCA_STATUS
  CONTATO
  FOLLOW_UP
  NOTA
  RETORNO
}

enum TipoEnvioCapi {
  LEAD
  PURCHASE
}

/*
 * Agência: o inquilino do SaaS. Tudo pertence a uma — clientes, usuários,
 * tarefas — e nenhuma consulta do painel atravessa essa fronteira. A jl.ads é a
 * primeira agência; os dados que existiam antes da camada nasceram nela.
 */
model Agencia {
  id       String   @id @default(cuid())
  nome     String
  slug     String   @unique
  ativa    Boolean  @default(true)
  criadoEm DateTime @default(now())

  clientes Cliente[]
  usuarios Usuario[]
  tarefas  Tarefa[]
}

model Cliente {
  id              String  @id @default(cuid())
  // Sem valor padrão de propósito: registro sem agência não pode existir, e
  // um padrão jogaria em silêncio o dado de uma agência dentro de outra.
  agenciaId       String
  nome            String
  contaAnunciosId String?
  fuso            String    @default("America/Sao_Paulo")
  ativo           Boolean   @default(true)
  funil           TipoFunil @default(COMPLETO)

  /*
   * Lado comercial: dados da jl.ads sobre esse cliente, não do cliente. Só o
   * administrador enxerga. Gestor e atendente seguem vendo leads e campanhas.
   */
  ciclo          CicloCliente @default(ATIVO)
  feeMensal      Decimal?     @db.Decimal(12, 2)
  diaVencimento  Int? // 1 a 28, para existir em todo mês
  inicioContrato DateTime?
  documento      String? // CNPJ ou CPF
  contatoNome    String?
  contatoEmail   String?
  contatoTelefone String?
  linkPagamento  String? // link fixo de cobrança, enquanto não houver provedor
  observacoes    String?

  // Prospecção: de onde veio, o que faz, quando retomar e por que foi perdido.
  nicho          String?
  origem         String? // indicação, Instagram, abordagem fria, evento
  instagram      String?
  site           String?
  proximoContato DateTime? @db.Date
  motivoPerda    String?
  reuniaoEm      DateTime? // data e hora da reunião agendada

  // Credenciais do Meta por cliente. Token de usuário do sistema da BM da JL Ads.
  pixelId        String?
  capiToken      String?
  marketingToken String?

  // Link de confirmação que o cliente abre sem senha. Trocar o token derruba o
  // link antigo, que é o que se faz quando alguém sai da equipe dele.
  tokenConfirmacao String? @unique

  criadoEm DateTime @default(now())

  numeros    NumeroWhatsapp[]
  usuarios   Usuario[]
  cliques    Clique[]
  leads      Lead[]
  eventos    Evento[]
  gastos     Gasto[]
  enviosCapi EnvioCapi[]
  faturas    Fatura[]
  tarefas    Tarefa[]
  propostas  Proposta[]
  interacoes Interacao[]

  agencia Agencia @relation(fields: [agenciaId], references: [id])

  @@index([agenciaId, ciclo])
}

/*
 * Cada toque num prospect: mensagem, ligação, reunião. É o histórico que
 * responde "o que eu já falei com essa pessoa?" antes de retomar o contato.
 */
model Interacao {
  id        String        @id @default(cuid())
  clienteId String
  tipo      TipoInteracao
  descricao String
  criadoEm  DateTime      @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, criadoEm])
}

/*
 * Cobrança mensal de um cliente. Uma por mês de competência, gerada pela rotina
 * diária no primeiro dia do mês para quem está ativo e tem fee.
 */
/*
 * Tarefa da operação. clienteId nulo = tarefa da jl.ads, sem dono externo:
 * proposta a escrever, conteúdo a gravar, cobrança a fazer. Com clienteId, é
 * trabalho daquele cliente e aparece dentro do ambiente dele.
 */
model Tarefa {
  id        String       @id @default(cuid())
  agenciaId String
  clienteId String?
  titulo    String
  descricao String?
  prazo     DateTime?    @db.Date
  status    StatusTarefa @default(ABERTA)
  criadoEm  DateTime     @default(now())
  feitoEm   DateTime?

  // Com horário, a tarefa ocupa um bloco na agenda; sem, fica no dia inteiro.
  inicio     DateTime?
  duracaoMin Int?

  // Tarefa criada pela mudança de etapa. A chave diz de qual etapa ela veio,
  // para não duplicar e para concluir sozinha quando o prospect avança.
  automatica Boolean @default(false)
  chave      String?

  criadoPorId String?
  agencia     Agencia  @relation(fields: [agenciaId], references: [id])
  cliente     Cliente? @relation(fields: [clienteId], references: [id])
  criadoPor   Usuario? @relation(fields: [criadoPorId], references: [id])

  @@index([agenciaId, status, prazo])
  @@index([clienteId, status])
  @@index([agenciaId, status, inicio])
}

/*
 * Proposta comercial da jl.ads para um prospect. O prospect é um Cliente em
 * etapa inicial do ciclo: aceitar a proposta o torna ativo, com o fee dela.
 *
 * O lead abre pelo link, sem senha, e responde por ali mesmo. "Visualizada" é
 * derivada de visualizadaEm, não é status: aberta e aceita não se excluem.
 */
model Proposta {
  id        String         @id @default(cuid())
  clienteId String
  token     String         @unique
  status    StatusProposta @default(RASCUNHO)

  titulo      String
  apresentacao String? // parágrafo de abertura, escrito para esse lead
  escopo      Json // lista de { titulo, detalhe } do que está incluído
  feeMensal   Decimal? @db.Decimal(12, 2)
  setup       Decimal? @db.Decimal(12, 2) // valor único de implantação
  condicoes   String? // prazo mínimo, forma de pagamento, verba de mídia à parte
  validade    DateTime @db.Date

  enviadaEm     DateTime?
  visualizadaEm DateTime?
  visualizacoes Int       @default(0)
  respondidaEm  DateTime?
  aceitaPor     String? // nome digitado por quem aceitou
  motivoRecusa  String?

  // Acompanhamento depois do envio: quando retomar e o que já foi conversado.
  proximoContato DateTime? @db.Date
  notas          String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@index([clienteId, criadoEm])
  @@index([status])
}

model Fatura {
  id          String       @id @default(cuid())
  clienteId   String
  competencia DateTime     @db.Date // primeiro dia do mês cobrado
  valor       Decimal      @db.Decimal(12, 2)
  vencimento  DateTime     @db.Date
  status      StatusFatura @default(ABERTA)
  pagoEm      DateTime?
  linkPagamento String?
  observacao  String?
  criadoEm    DateTime     @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@unique([clienteId, competencia])
  @@index([clienteId, vencimento])
  @@index([status, vencimento])
}

model NumeroWhatsapp {
  id        String  @id @default(cuid())
  clienteId String
  numero    String // E.164 só com dígitos, ex: 5511999999999
  rotulo    String?
  ativo     Boolean @default(true)

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
}

model Usuario {
  id        String  @id @default(cuid())
  agenciaId String
  clienteId String? // nulo = equipe da agência, vê todos os clientes dela
  // Dono da plataforma: cria agências. Não tem nada a ver com o papel dentro
  // de uma agência, e não dá acesso aos dados de outras agências pelo painel.
  plataforma Boolean @default(false)
  nome      String
  email     String  @unique
  senhaHash String
  papel     Papel   @default(ATENDENTE)
  ativo     Boolean @default(true)

  criadoEm DateTime @default(now())

  agencia          Agencia  @relation(fields: [agenciaId], references: [id])
  cliente          Cliente? @relation(fields: [clienteId], references: [id])
  leadsResponsavel Lead[]   @relation("responsavel")
  eventos          Evento[]
  tarefas          Tarefa[]

  @@index([clienteId])
}

model Clique {
  id        String @id @default(cuid())
  clienteId String
  codigo    String

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  campaignId String?
  adsetId    String?
  adId       String?

  fbclid    String?
  fbp       String?
  fbc       String?
  ip        String?
  userAgent String?
  url       String?

  /*
   * O que a pessoa escolheu na landing page: o serviço do botão que ela clicou,
   * a opção marcada num formulário, ou o texto do próprio botão. É por aqui que
   * quem atende reconhece de quem se trata, em vez de decorar telefone.
   */
  interesse String?

  /*
   * Nome e telefone que a própria pessoa preencheu na landing page, quando a
   * página tem formulário antes do botão de WhatsApp. É o que permite a quem
   * atende reconhecer dez pedidos do mesmo serviço no mesmo dia.
   */
  nomeVisitante     String?
  telefoneVisitante String?

  status   StatusClique @default(PENDENTE)
  criadoEm DateTime     @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id])
  lead    Lead?

  @@unique([clienteId, codigo])
  @@index([clienteId, status, criadoEm])
  @@index([clienteId, adId])
}

model Lead {
  id             String  @id @default(cuid())
  clienteId      String
  cliqueId       String? @unique
  leadAnteriorId String? // oportunidade nova de um telefone que já foi lead

  // Opcional: a confirmação em lote pelo cliente não exige digitar telefone.
  // Sem ele o lead conta em CPL, CAC e ROAS, mas fica fora da fila de follow-up
  // com botão de abrir conversa.
  telefone String?
  nome     String?

  origem     Origem     @default(MANUAL)
  status     StatusLead @default(NOVO)
  atribuicao Atribuicao @default(DESCONHECIDA)

  mensagemEm DateTime // horário da mensagem, base da janela de atribuição
  valorVenda Decimal? @db.Decimal(12, 2)
  motivoPerda String?

  responsavelId String?

  criadoEm    DateTime  @default(now())
  fechadoEm   DateTime?
  arquivadoEm DateTime?

  cliente       Cliente   @relation(fields: [clienteId], references: [id])
  clique        Clique?   @relation(fields: [cliqueId], references: [id])
  leadAnterior  Lead?     @relation("retorno", fields: [leadAnteriorId], references: [id])
  leadsSeguintes Lead[]   @relation("retorno")
  responsavel   Usuario?  @relation("responsavel", fields: [responsavelId], references: [id])

  eventos    Evento[]
  enviosCapi EnvioCapi[]

  @@index([clienteId, telefone])
  @@index([clienteId, status, criadoEm])
  @@index([clienteId, criadoEm])
}

model Evento {
  id        String     @id @default(cuid())
  clienteId String
  leadId    String
  tipo      TipoEvento
  descricao String?
  usuarioId String?
  criadoEm  DateTime   @default(now())

  cliente Cliente  @relation(fields: [clienteId], references: [id])
  lead    Lead     @relation(fields: [leadId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([leadId, criadoEm])
  @@index([clienteId, criadoEm])
}

model Gasto {
  id         String   @id @default(cuid())
  clienteId  String
  adId       String
  adsetId    String?
  campaignId String?

  adNome       String?
  adsetNome    String?
  campaignNome String?

  dia          DateTime @db.Date
  valor        Decimal  @db.Decimal(12, 2)
  impressoes   Int      @default(0)
  cliques      Int      @default(0)
  atualizadoEm DateTime @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@unique([clienteId, adId, dia])
  @@index([clienteId, dia])
}

model EnvioCapi {
  id        String        @id @default(cuid())
  clienteId String
  leadId    String
  eventId   String        @unique // event_id próprio, para deduplicação no Meta
  tipo      TipoEnvioCapi
  valor     Decimal?      @db.Decimal(12, 2)

  statusResposta Int?
  resposta       String?
  payload        Json
  tentativas     Int      @default(0)
  enviadoEm      DateTime?
  criadoEm       DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id])
  lead    Lead    @relation(fields: [leadId], references: [id])

  @@index([clienteId, criadoEm])
  @@index([leadId])
}
