# Desenvolvimento local (npm run db:start). Em produção, use a URL do Supabase.
DATABASE_URL="postgresql://usuario:senha@host:5432/postgres?sslmode=require"

# Segredo da sessão do painel. Em produção, gere outro com: openssl rand -base64 32
AUTH_SECRET="troque-este-segredo-em-producao-0000000000"

# Domínio público onde o painel e o script de rastreamento rodam.
APP_URL="http://localhost:3000"
